<Window x:Class="БДШКА.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора"
        Width="1100"
        Height="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#498C51"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

    </Window.Resources>


    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ВЕРХ -->

        <Grid Grid.Row="0"
              Margin="0,0,0,15">

            <TextBlock Text="Товары"
                       FontFamily="Comic Sans MS"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#498C51"
                       HorizontalAlignment="Left"/>

            <TextBlock x:Name="AdminNameTextBlock"
                       FontFamily="Comic Sans MS"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="#498C51"/>

        </Grid>


        <!-- ПОИСК И ФИЛЬТРЫ -->

        <Grid Grid.Row="1"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Height="40"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"/>

            <ComboBox x:Name="SortComboBox"
                      Grid.Column="1"
                      SelectedIndex="0"
                      SelectionChanged="SortComboBox_SelectionChanged">

                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="Цена: по возрастанию"/>
                <ComboBoxItem Content="Цена: по убыванию"/>

            </ComboBox>

            <ComboBox x:Name="ManufacturerComboBox"
                      Grid.Column="2"
                      SelectedIndex="0"
                      SelectionChanged="ManufacturerComboBox_SelectionChanged">

                <ComboBoxItem Content="Все производители"/>

            </ComboBox>

        </Grid>


        <!-- КОЛИЧЕСТВО -->

        <TextBlock x:Name="ProductsCountTextBlock"
                   Grid.Row="1"
                   Margin="0,45,0,5"
                   FontFamily="Comic Sans MS"
                   FontSize="13"
                   Foreground="Gray"/>


        <!-- СПИСОК ТОВАРОВ -->

        <ListView x:Name="ProductsListView"
                  Grid.Row="2"
                  BorderThickness="0"
                  Background="White"
                  SelectionMode="Single"
                  HorizontalContentAlignment="Stretch">

            <ListView.ItemContainerStyle>

                <Style TargetType="ListViewItem">

                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>

                    <Setter Property="Padding"
                            Value="0"/>

                    <Setter Property="Margin"
                            Value="0,5"/>

                </Style>

            </ListView.ItemContainerStyle>


            <ListView.ItemTemplate>

                <DataTemplate>

                    <!-- ОБЩАЯ РАМКА ТОВАРА -->

                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            Padding="10">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="Background"
                                        Value="White"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding QuantityInStock}"
                                                 Value="0">

                                        <Setter Property="Background"
                                                Value="#E5E5E5"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <!-- ФОТО -->
                                <ColumnDefinition Width="190"/>

                                <!-- ИНФОРМАЦИЯ -->
                                <ColumnDefinition Width="*"/>

                                <!-- НАЛИЧИЕ -->
                                <ColumnDefinition Width="150"/>

                                <!-- КНОПКИ АДМИНА -->
                                <ColumnDefinition Width="190"/>

                            </Grid.ColumnDefinitions>


                            <!-- ФОТО -->

                            <Border Grid.Column="0"
                                    BorderBrush="Black"
                                    BorderThickness="1"
                                    Height="120"
                                    Margin="5">

                                <Image Source="{Binding ImageForDisplay}"
       Width="150"
       Height="105"
       Stretch="Uniform"
       HorizontalAlignment="Center"
       VerticalAlignment="Center"/>

                            </Border>


                            <!-- НАЗВАНИЕ / ПРОИЗВОДИТЕЛЬ / ЦЕНА -->

                            <Border Grid.Column="1"
                                    BorderBrush="Black"
                                    BorderThickness="1"
                                    Height="120"
                                    Margin="5"
                                    Padding="12">

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="Comic Sans MS"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <TextBlock FontFamily="Comic Sans MS"
                                               FontSize="14"
                                               Margin="0,0,0,6">

                                        <Run Text="Производитель: "/>
                                        <Run Text="{Binding Manufacurer}"/>

                                    </TextBlock>

                                    <TextBlock FontFamily="Comic Sans MS"
                                               FontSize="14">

                                        <Run Text="Цена: "/>
                                        <Run Text="{Binding price}"/>
                                        <Run Text=" руб."/>

                                    </TextBlock>

                                </StackPanel>

                            </Border>


                            <!-- НАЛИЧИЕ НА СКЛАДЕ -->

                            <Border Grid.Column="2"
                                    BorderBrush="Black"
                                    BorderThickness="1"
                                    Height="120"
                                    Margin="5">

                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center">

                                    <TextBlock Text="Наличие на"
                                               FontFamily="Comic Sans MS"
                                               FontSize="13"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="складе"
                                               FontFamily="Comic Sans MS"
                                               FontSize="13"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding QuantityInStock}"
                                               FontFamily="Comic Sans MS"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"/>

                                </StackPanel>

                            </Border>


                            <!-- КНОПКИ АДМИНИСТРАТОРА -->

                            <StackPanel Grid.Column="3"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">

                                <Button Content="Изменить"
                                        Width="145"
                                        Margin="5"
                                        Click="EditButton_Click"/>

                                <Button Content="Удалить"
                                        Width="145"
                                        Margin="5"
                                        Background="#B94A48"
                                        Click="DeleteButton_Click"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>


        <!-- НИЖНИЕ КНОПКИ -->

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Добавить товар"
                    Width="150"
                    Click="AddButton_Click"/>

            <Button Content="Выйти"
                    Width="100"
                    Background="White"
                    Foreground="#498C51"
                    Click="ExitButton_Click"/>

        </StackPanel>

    </Grid>

</Window>