<Window x:Class="БДШКА.RegistrationWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Регистрация"
Width="800"
Height="800"
WindowStartupLocation="CenterScreen"
ResizeMode="NoResize"
Background="White">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#498C51"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="0,0,0,-84">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="193*"/>
        </Grid.ColumnDefinitions>

        <Border Width="450"
            Padding="35"
            Background="#76E383"
            CornerRadius="15"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" Grid.Column="1" Margin="147,45,0,0">

            <StackPanel>

                <TextBlock Text="Регистрация"
                       FontFamily="Comic Sans MS"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#498C51"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

                <!-- ФАМИЛИЯ -->
                <TextBlock Text="Фамилия"
                       FontFamily="Comic Sans MS"
                       FontSize="16"
                       Foreground="#498C51"/>

                <TextBox x:Name="SurnameTextBox"/>

                <!-- ИМЯ -->
                <TextBlock Text="Имя"
                       FontFamily="Comic Sans MS"
                       FontSize="16"
                       Foreground="#498C51"/>

                <TextBox x:Name="NameTextBox"/>

                <!-- ОТЧЕСТВО -->
                <TextBlock Text="Отчество"
                       FontFamily="Comic Sans MS"
                       FontSize="16"
                       Foreground="#498C51"/>

                <TextBox x:Name="PatronymicTextBox"/>

                <!-- ЛОГИН -->
                <TextBlock Text="Логин"
                       FontFamily="Comic Sans MS"
                       FontSize="16"
                       Foreground="#498C51"/>

                <TextBox x:Name="LoginTextBox"/>

                <!-- ПАРОЛЬ -->
                <TextBlock Text="Пароль"
                       FontFamily="Comic Sans MS"
                       FontSize="16"
                       Foreground="#498C51"/>

                <PasswordBox x:Name="PasswordBox"/>

                <!-- ПОВТОР ПАРОЛЯ -->
                <TextBlock Text="Повторите пароль"
                       FontFamily="Comic Sans MS"
                       FontSize="16"
                       Foreground="#498C51"/>

                <PasswordBox x:Name="RepeatPasswordBox"/>

                <!-- РЕГИСТРАЦИЯ -->
                <Button Content="Зарегистрироваться"
                    Click="RegisterButton_Click"
                    Margin="0,5,0,0"/>

                <!-- ВОЗВРАТ -->
                <Button Content="Вернуться ко входу"
                    Click="BackButton_Click"
                    Margin="0,10,0,0"
                    Background="White"
                    Foreground="#498C51"/>

            </StackPanel>

        </Border>

        <!-- ИКОНКА -->
        <Image Source="pack://application:,,,/Resources/icon.jpeg"
           Width="44"
           Height="40"
           Stretch="Uniform"
          HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Margin="182,80,0,0" Grid.Column="1"/>

    </Grid>
</Window>
