<Window x:Class="БДШКА.MainWindow"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Вход"
Width="800"
Height="500"
WindowStartupLocation="CenterScreen"
ResizeMode="NoResize"
Background="White">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5,0,20"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="#498C51"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Width="400"
            Padding="35"
            Background="#76E383"
            CornerRadius="15"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" Height="464">
            <StackPanel>
                <TextBlock Text="Вход"
                       FontFamily="Comic Sans MS"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#498C51"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>
                <TextBlock Text="Логин"
                       FontFamily="Comic Sans MS"
                       FontSize="16"
                       Foreground="#498C51"/>
                <TextBox x:Name="LoginTextBox"/>
                <TextBlock Text="Пароль"
                       FontFamily="Comic Sans MS"
                       FontSize="16"
                       Foreground="#498C51"/>
                <PasswordBox x:Name="PasswordBox"/>
                <Button Content="Войти"
                    Click="LoginButton_Click"/>
                <Button Content="Регистрация"
                    Click="RegistrationButton_Click"
                    Background="White"
                    Foreground="#498C51" Height="47"/>
                <Button Content="Войти как гость"
            Width="342"
            Click="GuestButton_Click"/>
            </StackPanel>

        </Border>
        <Image Source="pack://application:,,,/Resources/icon.jpeg"
       Width="44"
       Height="40"
       Stretch="Uniform"
       HorizontalAlignment="Left"
       VerticalAlignment="Top"
       Margin="235,71,0,0"/>

    </Grid>
</Window>
