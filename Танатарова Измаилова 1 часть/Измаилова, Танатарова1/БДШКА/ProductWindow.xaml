<Window x:Class="БДШКА.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Width="600"
        Height="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily"
                    Value="Comic Sans MS"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Padding"
                    Value="8,5"/>
            <Setter Property="Margin"
                    Value="0,3,0,10"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily"
                    Value="Comic Sans MS"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Margin"
                    Value="0,3,0,10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily"
                    Value="Comic Sans MS"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Background"
                    Value="#498C51"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <TextBlock x:Name="TitleTextBlock"
                       Text="Добавление товара"
                       FontFamily="Comic Sans MS"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#498C51"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Артикул"
                       FontFamily="Comic Sans MS"/>

            <TextBox x:Name="ArtTextBox"/>

            <TextBlock Text="Название"
                       FontFamily="Comic Sans MS"/>

            <TextBox x:Name="NameTextBox"/>

            <TextBlock Text="Категория"
                       FontFamily="Comic Sans MS"/>

            <ComboBox x:Name="CategoryComboBox"/>

            <TextBlock Text="Количество на складе"
                       FontFamily="Comic Sans MS"/>

            <TextBox x:Name="QuantityTextBox"/>

            <TextBlock Text="Единица измерения"
                       FontFamily="Comic Sans MS"/>

            <TextBox x:Name="UnitTextBox"/>

            <TextBlock Text="Поставщик"
                       FontFamily="Comic Sans MS"/>

            <TextBox x:Name="SupplierTextBox"/>

            <TextBlock Text="Цена"
                       FontFamily="Comic Sans MS"/>

            <TextBox x:Name="PriceTextBox"/>

            <TextBlock Text="Максимальная скидка"
                       FontFamily="Comic Sans MS"/>

            <TextBox x:Name="SizeMaxSaleTextBox"/>

            <TextBlock Text="Производитель"
                       FontFamily="Comic Sans MS"/>

            <TextBox x:Name="ManufacturerTextBox"/>

            <TextBlock Text="Скидка"
                       FontFamily="Comic Sans MS"/>

            <TextBox x:Name="SaleTextBox"/>

            <TextBlock Text="Описание"
                       FontFamily="Comic Sans MS"/>

            <TextBox x:Name="DescriptionTextBox"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Изображение"
                       FontFamily="Comic Sans MS"/>

            <TextBox x:Name="ImageTextBox"
                     IsReadOnly="True"/>

            <Button Content="Выбрать изображение"
                    Click="SelectImageButton_Click"
                    Margin="0,0,0,10"/>

            <Border Width="300"
                    Height="200"
                    BorderBrush="Black"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15">

                <Image x:Name="ImagePreview"
                       Width="300"
                       Height="200"
                       Stretch="Uniform"/>
            </Border>

            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Click="SaveButton_Click"
                    Margin="0,0,0,10"/>

            <Button Content="Отмена"
                    Click="CancelButton_Click"
                    Background="White"
                    Foreground="#498C51"/>

        </StackPanel>

    </ScrollViewer>

</Window>