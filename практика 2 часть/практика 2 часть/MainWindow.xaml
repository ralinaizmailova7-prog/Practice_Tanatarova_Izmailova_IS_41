<Window x:Class="практика2часть.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:практика2часть"
        mc:Ignorable="d"
        Title="MainWindow" Height="618" Width="800">
    <Grid Margin="0,0,0,11">
        <Grid Margin="0,0,0,33">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="250" Height="601" Margin="0,10,0,0">
                <TextBlock Text="Вход в систему" FontSize="18" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <TextBlock Text="Логин:"/>
                <TextBox x:Name="LoginTextBox" Margin="0,0,0,10" Height="25"/>

                <TextBlock Text="Пароль:"/>
                <PasswordBox x:Name="PasswordTextBox" Margin="0,0,0,10" Height="25"/>
                <TextBlock Text="Соберите картинку:" Margin="0,20,0,5" HorizontalAlignment="Center"/>
                <UniformGrid x:Name="PuzzleGrid" Rows="2" Columns="2" Width="200" Height="200" HorizontalAlignment="Center"/>
                <TextBlock x:Name="PuzzleStatusText" Foreground="Red" HorizontalAlignment="Center" Margin="0,5,0,10"/>

                <Button x:Name="LoginButton" Content="Войти" Height="30" Click="LoginButton_Click" />

                <TextBlock x:Name="MessageText" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" Width="250" Height="91"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
