<Window x:Class="практика2часть.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:практика2часть"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление пользователями" FontSize="18" Margin="0,0,0,10"/>

        <DataGrid x:Name="UsersDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="UsersDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="40"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding login}" Width="120"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding role}" Width="120"/>
                <DataGridTextColumn Header="Заблокирован" Binding="{Binding is_blocked}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Логин:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="NewLoginBox" Width="100" Margin="0,0,10,0"/>

            <TextBlock Text="Пароль:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="NewPasswordBox" Width="100" Margin="0,0,10,0"/>

            <TextBlock Text="Роль:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="NewRoleBox" Width="120" Margin="0,0,10,0">
                <ComboBoxItem Content="Пользователь" IsSelected="True"/>
                <ComboBoxItem Content="Администратор"/>
            </ComboBox>

            <Button Content="Добавить пользователя" Click="AddUser_Click" Margin="0,0,10,0"/>
            <Button Content="Снять блокировку" Click="Unblock_Click"/>
        </StackPanel>
    </Grid>
</Window>
